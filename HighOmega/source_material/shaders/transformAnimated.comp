#version 450

#extension GL_ARB_separate_shader_objects : enable
#extension GL_ARB_shading_language_420pack : enable
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require

layout (local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

struct VertexFromVertBufWide
{
	vec4 eCol;
	vec2 uv;
	uint Norm;
};

#define ReadVertex(v,i,j) {uint triCount = giantVB.dat[i];\
						   uint offsetToVertices = 2 + (triCount * 3); offsetToVertices += i + ((24 - ((offsetToVertices * 4) % 24 /* sizeof(RasterVertex) */ )) / 4);\
						   v.eCol.x = uintBitsToFloat(giantVB.dat[offsetToVertices + (j) * 6]);\
						   v.eCol.y = uintBitsToFloat(giantVB.dat[offsetToVertices + (j) * 6 + 1]);\
						   v.eCol.z = uintBitsToFloat(giantVB.dat[offsetToVertices + (j) * 6 + 2]);\
						   v.eCol.w = uintBitsToFloat(giantVB.dat[offsetToVertices + (j) * 6 + 3]);\
						   v.uv = unpackHalf2x16(giantVB.dat[offsetToVertices + (j) * 6 + 4]);\
						   v.Norm = giantVB.dat[offsetToVertices + (j) * 6 + 5];}

#define StoreVertex(v,i,j) {uint triCount = giantVB.dat[i];\
							uint offsetToVertices = 2 + (triCount * 3); offsetToVertices += i + ((24 - ((offsetToVertices * 4) % 24 /* sizeof(RasterVertex) */ )) / 4);\
							giantVB.dat[offsetToVertices + (j) * 6] = floatBitsToUint(v.eCol.x);\
							giantVB.dat[offsetToVertices + (j) * 6 + 1] = floatBitsToUint(v.eCol.y);\
							giantVB.dat[offsetToVertices + (j) * 6 + 2] = floatBitsToUint(v.eCol.z);\
							giantVB.dat[offsetToVertices + (j) * 6 + 3] = floatBitsToUint(v.eCol.w);\
							giantVB.dat[offsetToVertices + (j) * 6 + 4] = packHalf2x16(v.uv);\
							giantVB.dat[offsetToVertices + (j) * 6 + 5] = v.Norm;}

layout(scalar, binding = 0) buffer GiantVertBuffer
{
	uint dat[];
} giantVB;

struct VertexAnimWeights
{
	vec4 bonesWeights;
};

struct AnimParam
{
	uint vertCount;
	uint srcIdxVertOffset;
	uint dstIdxVertOffset;
	uint nBones;
};

layout (binding = 1) buffer AnimateParamsStructSSBO
{
	AnimParam params[];
} animateParams;

layout (set = 1, binding = 0) buffer SourceAnimInfoSSBO
{
	VertexAnimWeights vertAnimWeights[];
} sourceAnimInfo[];

layout (set = 2, binding = 0) buffer ArmatureSSBO
{
	mat4 bones[];
} armature[];

uint toZSignXY(vec3 inpVec)
{
	uint retVal = ((uint((inpVec.x + 1.0) * 16383.0) << 16) | uint((inpVec.y + 1.0) * 32767.0));
	if (inpVec.z < 0.0) retVal |= 0x80000000u;
	return retVal;
}

float packVertexVelocity(vec3 inpVel, float inpPackedColor)
{
	float inpVelLen = length (inpVel);
	vec3 inpVelNorm = inpVel;
	if (inpVelLen != 0.0) inpVelNorm /= inpVelLen;
	uint zSignVelX = uint(clamp (inpVelNorm.x + 1.0, 0.0, 2.0) * 63.5);
	if (inpVelNorm.z < 0.0) zSignVelX |= 0x80;
	uint velY = uint (clamp(inpVelNorm.y + 1.0, 0.0, 2.0) * 127.5);
	uint velLen = clamp (uint(inpVelLen * 10.0), 0, 255);
	
	uint inpPackedColorUint = floatBitsToUint(inpPackedColor);
	inpPackedColorUint &= 0x000000FFu;
	inpPackedColorUint |= (zSignVelX << 8);
	inpPackedColorUint |= (velY << 16);
	inpPackedColorUint |= (velLen << 24);
	return uintBitsToFloat(inpPackedColorUint);
}

vec3 fromZSignXY(uint inpPack)
{
	vec3 retVal;
	retVal.x = (float((inpPack & 0x7FFF0000u) >> 16) / 32766.0) * 2.0 - 1.0;
	retVal.y = (float(inpPack & 0x0000FFFFu) / 65534.0) * 2.0 - 1.0;
	vec2 xyVec = vec2(retVal.x, retVal.y);
	retVal.z = sqrt(clamp (1.0 - dot(xyVec, xyVec), 0.0, 1.0));
	if ((inpPack & 0x80000000u) != 0) retVal.z = -retVal.z;
	return retVal;
}

uint getBone (float weightBone)
{
	return ((floatBitsToUint(weightBone) & 0xFFFF0000) >> 16);
}

float getWeight (float weightBone)
{
	return float ((floatBitsToUint(weightBone) & 0x0000FFFF)) / 65535.0;
}

#define SET_ANIM_INFLUENCE(geomIdx,boneWeightPacked,curTrans,prevTrans) { \
	float curWeight = getWeight (boneWeightPacked); \
	uint  curBone   = getBone   (boneWeightPacked); \
	curTrans  = curWeight * armature[geomIdx].bones[curBone]; \
	prevTrans = curWeight * armature[geomIdx].bones[curBone + animateParams.params[gl_GlobalInvocationID.y].nBones]; \
}

#define ADD_ANIM_INFLUENCE(geomIdx,boneWeightPacked,curTrans,prevTrans) { \
	float curWeight = getWeight (boneWeightPacked); \
	uint  curBone   = getBone   (boneWeightPacked); \
	curTrans  += curWeight * armature[geomIdx].bones[curBone]; \
	prevTrans += curWeight * armature[geomIdx].bones[curBone + animateParams.params[gl_GlobalInvocationID.y].nBones]; \
}

mat4 DirectionTransform(mat4 transform)
{
	mat4 retVal = mat4(1.0);
	retVal[0].xyz = cross(transform[1].xyz, transform[2].xyz);
	retVal[1].xyz = cross(transform[2].xyz, transform[0].xyz);
	retVal[2].xyz = cross(transform[0].xyz, transform[1].xyz);
	return retVal;
}

void main()
{
	if ( gl_GlobalInvocationID.x >= animateParams.params[gl_GlobalInvocationID.y].vertCount ) return ;
	
	VertexAnimWeights curVertAnimWeights = sourceAnimInfo[nonuniformEXT(gl_GlobalInvocationID.y)].vertAnimWeights[gl_GlobalInvocationID.x];
	
	mat4 vTrans, vPrevTrans;
	vPrevTrans = vTrans = mat4(1.0);
	if ( getBone (curVertAnimWeights.bonesWeights.x) != 0x0000FFFF ) SET_ANIM_INFLUENCE(nonuniformEXT(gl_GlobalInvocationID.y),curVertAnimWeights.bonesWeights.x,vTrans,vPrevTrans)
	if ( getBone (curVertAnimWeights.bonesWeights.y) != 0x0000FFFF ) ADD_ANIM_INFLUENCE(nonuniformEXT(gl_GlobalInvocationID.y),curVertAnimWeights.bonesWeights.y,vTrans,vPrevTrans)
	if ( getBone (curVertAnimWeights.bonesWeights.z) != 0x0000FFFF ) ADD_ANIM_INFLUENCE(nonuniformEXT(gl_GlobalInvocationID.y),curVertAnimWeights.bonesWeights.z,vTrans,vPrevTrans)
	if ( getBone (curVertAnimWeights.bonesWeights.w) != 0x0000FFFF ) ADD_ANIM_INFLUENCE(nonuniformEXT(gl_GlobalInvocationID.y),curVertAnimWeights.bonesWeights.w,vTrans,vPrevTrans)

	VertexFromVertBufWide sourceVert;
	ReadVertex (sourceVert, animateParams.params[gl_GlobalInvocationID.y].srcIdxVertOffset, gl_GlobalInvocationID.x)

	vec3 curEdge = (vTrans * vec4 (sourceVert.eCol.xyz, 1.0)).xyz;
	vec3 edgeVel = curEdge - (vPrevTrans * vec4 (sourceVert.eCol.xyz, 1.0)).xyz;
	sourceVert.eCol = vec4 (curEdge, packVertexVelocity(edgeVel, sourceVert.eCol.w));
	sourceVert.Norm = toZSignXY (normalize ((DirectionTransform(vTrans) * vec4 (fromZSignXY(sourceVert.Norm), 1.0)).xyz));

	StoreVertex (sourceVert, animateParams.params[gl_GlobalInvocationID.y].dstIdxVertOffset, gl_GlobalInvocationID.x)
}